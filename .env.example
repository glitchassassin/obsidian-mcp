# Optional non-secret settings. Enter credentials through the private admin UI.
# Bind a specific NAS LAN IPv4 address if the host has multiple interfaces.
ADMIN_BIND_IP=0.0.0.0
ADMIN_PORT=8090
# Optional comma-separated hostnames; IP access works without this setting.
ADMIN_ALLOWED_HOSTS=
OBSIDIAN_MCP_ADMIN_IMAGE=ghcr.io/glitchassassin/obsidian-mcp-admin:v0.3.0
OBSIDIAN_MCP_SYNC_IMAGE=ghcr.io/glitchassassin/obsidian-mcp-sync:v0.3.0
OBSIDIAN_MCP_COMMANDER_IMAGE=ghcr.io/glitchassassin/obsidian-mcp-desktop-commander:v0.3.0
OBSIDIAN_MCP_TUNNEL_IMAGE=ghcr.io/glitchassassin/obsidian-mcp-tunnel:v0.3.0
SYNC_MODE=bidirectional
SYNC_FILE_TYPES=image,audio,video,pdf,unsupported
SYNC_EXCLUDED_FOLDERS=
